# 复制为 .env 后按需修改：cp .env.example .env
#
# DSH 运行时镜像：由宿主上的 Dockerfile 构建，等价于
#   node:22-bookworm-slim + npm i -g @deepseek-ai/dsh@<版本>
DSH_IMAGE=dsh-web:0.2.0-rc.2

# 控制面统一入口端口（唯一必须放行的端口）
MT_EDGE_PORT=8090

# 监听地址：0.0.0.0 允许局域网访问；只本机访问改成 127.0.0.1
MT_BIND_IP=0.0.0.0

# 网关登录会话有效期（小时）。DSH 自身的 cookie 另有 30 天有效期
MT_SESSION_TTL_HOURS=12

TZ=Asia/Shanghai

# 租户运行时的文件权限模式。
# 内核 < 5.13（无 Landlock）或禁用 user namespace 的机器上必须是 danger-full-access，
# 否则每条命令都会以 SANDBOX_UNAVAILABLE 失败；此时容器本身即隔离边界。
DSH_PERMISSION_MODE=danger-full-access

# 每个租户的模型凭据由 bin/render.js 追加到本文件（MT_<租户>_GATEWAY_API_KEY），
# 也可用 bin/mt.sh key <租户> <值> 写入。
