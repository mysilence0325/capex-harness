# 复制为 .env 后按需修改：cp .env.example .env
#
# DSH 运行时镜像：由宿主上的 Dockerfile 构建，等价于
#   node:22-bookworm-slim + npm i -g @deepseek-ai/dsh@<版本>
DSH_IMAGE=dsh-web:0.2.0-rc.2

# 用本地源码构建时的原始基础镜像（bin/publish-image.sh 会以它为底，避免层层叠加）。
# 首次发布时脚本会自动写入本行。
#MT_BASE_IMAGE=dsh-web:0.2.0-rc.2

# 控制面统一入口端口（唯一必须放行的端口）
MT_EDGE_PORT=8090

# 前置反向代理把本部署挂在子路径下时填那个前缀（例如 /ai/harness），
# 于是 https://officeai.301.avic:496/ai/harness/ 就是租户入口。
# 改了它必须重建网关镜像并 bin/mt.sh up：网关是按 MT_BASE_PATH 生成
# 登录表单、跳转和 cookie Path 的。留空 = 直接挂在根路径（默认）。
#MT_BASE_PATH=/ai/harness

# ── USB Key 免口令登录（单点登录）───────────────────────────────────────────
# 身份网关（trp，:496）校验浏览器里的 Key 之后，把用户名写进一个 Cookie。这个
# Cookie 本身就是一份凭据，所以本网关只认**下面这些地址**送来的它 —— 否则任何
# 能直接访问公开端口的人，都能自己造一个 Cookie 冒名登录。
# 值是前置代理的地址，逗号分隔，支持 CIDR（例：15.11.40.44,10.11.0.0/16）。
# 留空 = 不开启 Key 登录，登录页与今天完全一样（纯口令部署就是这个状态）。
#MT_KEY_LOGIN_FROM=15.11.40.44
# 可选的第二道锁：让代理转发时加上 X-MT-Key-Auth 头，网关常数时间比对。
# 只配它、不配地址列表也行（代理地址不固定时用）。
#MT_KEY_LOGIN_SECRET=
# 身份网关写用户名的 Cookie 名（默认 KOAL_CERT_E）
#MT_KEY_LOGIN_COOKIE=KOAL_CERT_E
# 装了 Key 的浏览器打开入口页是否自动免口令登录（默认 1=自动；0=只留按钮）
#MT_KEY_LOGIN_AUTO=1

# 监听地址：0.0.0.0 允许局域网访问；只本机访问改成 127.0.0.1
MT_BIND_IP=0.0.0.0

# 网关登录会话有效期（小时）。DSH 自身的 cookie 另有 30 天有效期
MT_SESSION_TTL_HOURS=12

TZ=Asia/Shanghai

# 租户运行时的文件权限模式。默认 workspace-write：DSH 的沙箱链是 bwrap → Landlock，
# 容器里通常是 Landlock（内核 5.13+）。**没有可用沙箱时它会响亮地失败**
# （SANDBOX_UNAVAILABLE），而不是悄悄地在无约束下跑——这是刻意的。
# 内核 < 5.13 且没有 bwrap 的机器（例如 3.10 的 CentOS 7）必须显式写
# danger-full-access（容器本身即隔离边界），并把原因记进部署记录。
# 先跑 bin/sandbox-check.sh，它会给出这台机器上哪条路可用、该用哪个值。
#DSH_PERMISSION_MODE=workspace-write

# 强制走 bwrap 那条沙箱路（容器里默认走不到：DSH 自带的 bwrap 探针不建用户命名空间，
# 而容器没有 CAP_SYS_ADMIN 时建不出来）。只有在 bin/sandbox-check.sh 报告
# "bwrap 加 --unshare-user 可用" 时才打开；打开后 DSH 跳过探测、断言完全强制，
# bwrap 起不来就会直接报错（而不是悄悄降级）。
#MT_SANDBOX_BWRAP=1

# 每个租户的模型凭据由 bin/render.js 追加到本文件（MT_<租户>_GATEWAY_API_KEY），
# 也可用 bin/mt.sh key <租户> <值> 写入。共享凭据放在 model.env（env_file 注入）。

# ── 模型接入（真凭据）────────────────────────────────────────────────────────
# 真 key 只注入模型网关容器（mt-model-gateway），**不会**进任何租户容器。
# 租户容器里是 registry 按租户生成的占位 key（sk-mt-<租户>-…），
# 网关按它识别租户、换成真 key 再转发。见 README「模型接入」。
#
#MT_UPSTREAM_BASE=https://api.deepseek.com
#MT_UPSTREAM_API_KEY=sk-...

# ── 容器日志上限 ───────────────────────────────────────────────────────────
# Docker 的 json-file 驱动默认没有大小上限：容器一直往 stdout 写就会把磁盘写满
# （崩溃重启循环、每次请求写一行的代理都会这样）。这里给每个容器加上限，
# 上限 × 份数 = 单容器最多占用的日志空间。
# DSH 本身几乎不往 stdout 写（它写会话文件），这个上限主要防病态情况。
MT_LOG_MAX_SIZE=10m
MT_LOG_MAX_FILE=3

# ── 租户出口代理 ───────────────────────────────────────────────────────────
# 本机 net.ipv4.ip_forward=0，bridge 容器没有任何外网路由（连公共 DNS 都解析不了），
# 因此 DSH 的模型调用必须经出口代理。代理跑在宿主网络里，监听一个防火墙未放行的
# 端口，所以只有租户容器连得上。
#
# MT_EGRESS_PROXY 由 bin/mt.sh up 自动探测（mt-net 的网关地址）并写入本文件，通常不用手填。
#MT_EGRESS_PROXY=http://<mt-net 网关>:3128
MT_EGRESS_PORT=3128
# 只允许特定域名（逗号分隔的后缀，留空=任何公网地址；私网/回环地址始终被拒）
#MT_EGRESS_ALLOW=api.deepseek.com
# 直连不走代理的主机。默认已含 mock-model（验收用的假模型在 mt-net 内网，代理会拒它）；
# 你们自己的内网服务也要在这里列出，否则租户访问不到。
#MT_NO_PROXY=localhost,127.0.0.1,::1,mock-model

# 节点代理要向控制面注册它发现的租户。**留空时代理会退化成"只提供运维能力、不做注册"**，
# 而且这是静默的：界面一切正常，直到某个租户重启（启动 token 会轮换）之后，
# 统一入口才开始一直返回 303。doctor 会把留空判为失败。
#   MT_CONTROL_PLANE      控制面的 HTTPS 入口
#   MT_CONTROL_PLANE_CA   控制面的 CA 证书，路径是**代理容器里**的路径（state 挂在 /key）
MT_CONTROL_PLANE=https://CHANGE-ME:8090
MT_CONTROL_PLANE_CA=/key/tls/ca.crt
