{
  "name": "@deepseek-ai/dsh-capex",
  "description": "Capex offline Web profile overlay: local identity, desktop integration, and bounded data maintenance",
  "version": "0.2.1-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-desktop-open": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-storage": "workspace:*",
    "@deepseek-ai/dsh-local-user": "workspace:*",
    "@deepseek-ai/dsh-storage-maintenance": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
